    },
    "m_SourceType": 1,
    "m_FunctionName": "EdgeDetect",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float depth = SHADERGRAPH_SAMPLE_SCENE_DEPTH(UV);\r\nfloat depthL = SHADERGRAPH_SAMPLE_SCENE_DEPTH(UV - float2(TexelSize.x, 0));\r\nfloat depthR = SHADERGRAPH_SAMPLE_SCENE_DEPTH(UV + float2(TexelSize.x, 0));\r\nfloat depthU = SHADERGRAPH_SAMPLE_SCENE_DEPTH(UV - float2(0, TexelSize.y));\r\nfloat depthD = SHADERGRAPH_SAMPLE_SCENE_DEPTH(UV + float2(0, TexelSize.y));\r\nfloat diff = abs(depth - depthL) + abs(depth - depthR) + abs(depth - depthU) + abs(depth - depthD);\r\nEdge = step(Threshold, diff);"
}

